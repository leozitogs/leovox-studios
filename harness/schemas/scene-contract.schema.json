{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leovox.studio/schemas/scene-contract.schema.json",
  "title": "Contrato de cena Leovox",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "route", "viewports", "states", "acceptance", "forbidden"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 3 },
    "route": { "type": "string", "pattern": "^/" },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["desktop", "mobile", "reduced-motion"] }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
    "forbidden": { "type": "array", "items": { "type": "string", "minLength": 2 } }
  }
}
