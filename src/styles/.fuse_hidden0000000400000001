/* ============================================================
   Leovox Studios · Tokens de marca
   Regra de ouro: o site vive em preto. O verde e a luz da cena
   por cor, nunca por efeito. Off-white nunca e #FFFFFF.
   ============================================================ */

:root {
  /* ---------- Cores ---------- */
  --color-green: #19bc00;        /* verde vivo, primaria, identidade */
  --color-offwhite: #fbfbfb;     /* off-white, nunca #FFFFFF */
  --color-black: #000000;
  --color-gray-dark: #222222;
  --color-green-pastel: #c5f49d;

  /* ---------- Tipografia (familias) ---------- */
  --font-display: 'Anton', Impact, sans-serif;              /* headlines, statements monumentais */
  --font-numeric: 'Bebas Neue', 'Arial Narrow', sans-serif; /* numeracao, metricas, kickers, labels */
  --font-signature: 'Extenda 40', 'Anton', sans-serif;      /* momentos-assinatura */
  --font-body: 'Montserrat', Arial, sans-serif;             /* corpo institucional */
  --font-conversational: 'Poppins', Arial, sans-serif;      /* formulario, microcopy proximo */
  --font-seal: 'Lost in South', cursive;                    /* selo Isso e Leovox */
  --font-hand: 'Schoolbell', cursive;                       /* anotacao a mao, voz humana */

  /* ---------- Escala tipografica ---------- */
  --text-xs: 0.75rem;
  --text-sm: 0.875rem;
  --text-base: 1rem;
  --text-lg: 1.25rem;
  --text-xl: 1.75rem;
  --text-2xl: 2.5rem;
  --text-3xl: 4rem;
  --text-display: clamp(4rem, 10vw, 9rem);

  /* ---------- Espacamento ---------- */
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 1rem;
  --space-4: 1.5rem;
  --space-5: 2.5rem;
  --space-6: 4rem;
  --space-7: 6rem;
  --space-8: 10rem;

  /* ---------- Camadas ---------- */
  --z-canvas: 10;        /* canvas R3F persistente, o totem viaja aqui */
  --z-content: 20;
  --z-header: 50;
  --z-blade: 90;         /* lamina de verde chapado entre cenas */
  --z-cursor: 100;

  /* ---------- Movimento (referencia para o GSAP) ---------- */
  --duration-micro: 0.3s;        /* microinteracao: 0.2 a 0.4s */
  --duration-enter: 0.75s;       /* entrada de elemento: 0.6 a 0.9s */
  --duration-scene: 1.15s;       /* transicao entre cenas: 0.9 a 1.4s */
}

